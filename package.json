{
  "name": "pi-manage-todo-list",
  "version": "0.2.0",
  "description": "A pi extension that replicates GitHub Copilot's manage_todo_list tool",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tintinweb/pi-manage-todo-list.git"
  },
  "homepage": "https://github.com/tintinweb/pi-manage-todo-list#readme",
  "bugs": {
    "url": "https://github.com/tintinweb/pi-manage-todo-list/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "todo",
    "task-management",
    "productivity"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@mariozechner/pi-ai": "*",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"],
    "video": "https://github.com/tintinweb/pi-manage-todo-list/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-manage-todo-list/raw/master/media/screenshot.png"
  }
}
